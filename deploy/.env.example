# 部署用环境变量模板 —— 复制为 .env 后按需改真实值：
#   cp deploy/.env.example deploy/.env
# docker compose 会自动加载同目录下的 .env，compose 里用 ${XXX:-默认值} 引用。
# 注意：即使没有 .env，compose 里的 ${XXX:-默认值} 也会回退到下方默认值，所以本 demo 开箱即用。
MYSQL_ROOT_PASSWORD=mrlu
REDIS_PASSWORD=mrlu
RABBITMQ_USER=admin
RABBITMQ_PASS=mrlu
MINIO_ROOT_USER=mrlu
MINIO_ROOT_PASSWORD=mrlumrlu
APP_VERSION=1.0